APP_NAME=ResolveIQ
APP_ENV=development
API_PREFIX=/api/v1
DATABASE_URL=sqlite+aiosqlite:///./resolveiq.db

RETRIEVER_PROVIDER=local
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=resolveiq
AZURE_SEARCH_SEMANTIC_CONFIG=resolveiq-semantic

FOUNDRY_ENDPOINT=
FOUNDRY_API_KEY=
FOUNDRY_MODEL=

VERIFICATION_PROVIDER=deterministic
NLI_MODEL=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli

CORS_ORIGINS=http://localhost:5173
CONFIDENCE_REGENERATE_THRESHOLD=0.55
MAX_EVIDENCE=8
